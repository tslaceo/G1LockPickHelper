// Solver.as (the search from the goal in time slices, the key sequence, the effect of a key) and the 1.2.0 reference
// sequences (GoldenSolver.as, generated by tools/oracle/golden.lua from the 1.2.0 solver).

// Two plates, plate 0 pushes plate 1 with it (a connection 0 -> 1 with the plate).
FLPH_LockGraph LPHTests_TwoPlates()
{
	FLPH_LockGraph Graph;
	Graph.Plates = 2;
	Graph.Src.Add(0);
	Graph.Dst.Add(1);
	Graph.Dir.Add(1);
	return Graph;
}

// Plates without any connection.
FLPH_LockGraph LPHTests_FreePlates(int Plates)
{
	FLPH_LockGraph Graph;
	Graph.Plates = Plates;
	return Graph;
}

TArray<int> LPHTests_Holes2(int A, int B)
{
	TArray<int> Holes;
	Holes.Add(A);
	Holes.Add(B);
	return Holes;
}

// A solver that has the graph and has finished the search.
ULPH_Solver LPHTests_ReadySolver(UObject Outer, FLPH_LockGraph Graph)
{
	ULPH_Solver Solver = Cast<ULPH_Solver>(NewObject(Outer, ULPH_Solver::StaticClass()));
	Solver.Begin(Graph);
	int Calls = 0;
	while (!Solver.Step(1000000) && Calls < 1000)
		Calls++;
	return Solver;
}

ELPH_Key LPHTests_KeyOfLetter(FString Letter)
{
	if (Letter == "W")
		return ELPH_Key::W;
	if (Letter == "S")
		return ELPH_Key::S;
	if (Letter == "A")
		return ELPH_Key::A;
	if (Letter == "D")
		return ELPH_Key::D;
	return ELPH_Key::R;
}

// Presses the keys of a sequence one by one. True when none of them strained; Holes and Cursor end up where the
// sequence leaves the lock.
bool LPHTests_Replay(ULPH_Solver Solver, TArray<int>& Holes, int& Cursor, FString Keys)
{
	for (int i = 0; i < Keys.Len(); i++)
	{
		TArray<int> After;
		int NewCursor = Cursor;
		if (!Solver.Apply(Holes, Cursor, LPHTests_KeyOfLetter(Keys.Mid(i, 1)), After, NewCursor))
			return false;
		Holes = After;
		Cursor = NewCursor;
	}
	return true;
}

void LPHTests_Solver(ULPH_TestRun T)
{
	T.Begin("Solver");

	// A solver that was not given a lock.
	ULPH_Solver Fresh = Cast<ULPH_Solver>(NewObject(T, ULPH_Solver::StaticClass()));
	T.True(!Fresh.IsReady(), "a new solver is not ready");
	T.EqualInt(Fresh.Plates(), 0, "a new solver has no plates");
	TArray<int> Holes = LPHTests_Holes2(4, 4);
	TArray<ELPH_Key> Keys;
	T.True(Fresh.Solve(Holes, 0, Keys) == ELPH_SolveStatus::BadState, "a solver without a lock cannot solve");

	// The two-plate lock: Apply.
	ULPH_Solver Solver = LPHTests_ReadySolver(T, LPHTests_TwoPlates());
	T.True(Solver.IsReady(), "the two-plate solver is ready");
	T.EqualInt(Solver.Plates(), 2, "the two-plate solver: Plates");

	TArray<int> After;
	int Cursor = -1;
	T.True(Solver.Apply(Holes, 0, ELPH_Key::D, After, Cursor), "D at 4,4 is not a strain");
	T.EqualInt(After.Num(), 2, "D: two holes back");
	T.EqualInt(After[0], 5, "D moves the selected plate (0)");
	T.EqualInt(After[1], 5, "D moves the plate that is connected with it (1)");
	T.EqualInt(Cursor, 0, "D leaves the cursor");

	T.True(Solver.Apply(Holes, 0, ELPH_Key::A, After, Cursor), "A at 4,4 is not a strain");
	T.EqualInt(After[0], 3, "A moves the selected plate (0)");
	T.EqualInt(After[1], 3, "A moves the connected plate (1)");

	T.True(Solver.Apply(Holes, 1, ELPH_Key::A, After, Cursor), "A on plate 1 is not a strain");
	T.EqualInt(After[0], 4, "plate 1 has no connection: plate 0 stays");
	T.EqualInt(After[1], 3, "A moves plate 1");
	T.EqualInt(Cursor, 1, "A leaves the cursor on plate 1");

	// Strain: a hole must stay in 1..7. The input is left as it was.
	TArray<int> Six = LPHTests_Holes2(6, 6);
	T.True(Solver.Apply(Six, 0, ELPH_Key::D, After, Cursor), "D at 6,6 gives 7,7");
	T.EqualInt(After[0], 7, "6 -> 7 (0)");
	T.EqualInt(After[1], 7, "6 -> 7 (1)");
	T.True(!Solver.Apply(After, 0, ELPH_Key::D, Holes, Cursor), "D at 7,7 strains");
	T.EqualInt(After[0], 7, "a strain does not change the holes given");
	T.EqualInt(Holes[0], 7, "a strain gives the holes back unchanged (0)");
	T.EqualInt(Holes[1], 7, "a strain gives the holes back unchanged (1)");
	TArray<int> EdgeHoles = LPHTests_Holes2(4, 7);
	T.True(!Solver.Apply(EdgeHoles, 0, ELPH_Key::D, After, Cursor), "D strains when only the connected plate runs out");
	T.True(Solver.Apply(EdgeHoles, 1, ELPH_Key::A, After, Cursor), "plate 1 can still go back");
	TArray<int> One = LPHTests_Holes2(1, 4);
	T.True(!Solver.Apply(One, 0, ELPH_Key::A, After, Cursor), "A at hole 1 strains");

	// W and S move the cursor between plates, without wrapping.
	Holes = LPHTests_Holes2(4, 4);
	T.True(Solver.Apply(Holes, 0, ELPH_Key::W, After, Cursor), "W is never a strain");
	T.EqualInt(Cursor, 1, "W from plate 0 goes to plate 1");
	T.EqualInt(After[0], 4, "W does not change the holes (0)");
	T.EqualInt(After[1], 4, "W does not change the holes (1)");
	T.True(Solver.Apply(Holes, 1, ELPH_Key::W, After, Cursor), "W on the last plate is not a strain");
	T.EqualInt(Cursor, 1, "W on the last plate leaves the cursor");
	T.True(Solver.Apply(Holes, 0, ELPH_Key::S, After, Cursor), "S on the first plate is not a strain");
	T.EqualInt(Cursor, 0, "S on the first plate leaves the cursor");
	T.True(Solver.Apply(Holes, 1, ELPH_Key::S, After, Cursor), "S is never a strain");
	T.EqualInt(Cursor, 0, "S from plate 1 goes to plate 0");
	T.True(Solver.Apply(Six, 1, ELPH_Key::R, After, Cursor), "R is not a move of the solver");
	T.EqualInt(After[0], 6, "R leaves the holes");
	T.EqualInt(Cursor, 1, "R leaves the cursor");

	// An unusable state is refused (like a strain: false, nothing changed).
	TArray<int> Wrong;
	Wrong.Add(4);
	Wrong.Add(4);
	Wrong.Add(4);
	T.True(!Solver.Apply(Wrong, 0, ELPH_Key::D, After, Cursor), "Apply with three holes for two plates");
	T.True(!Solver.Apply(Holes, 2, ELPH_Key::W, After, Cursor), "Apply with the cursor past the last plate");
	T.True(!Solver.Apply(Holes, -1, ELPH_Key::D, After, Cursor), "Apply with a negative cursor");
	TArray<int> Zero = LPHTests_Holes2(0, 4);
	T.True(!Solver.Apply(Zero, 0, ELPH_Key::W, After, Cursor), "Apply with a hole out of 1..7");

	// Solve: from the goal there is nothing to press.
	TArray<int> Goal = LPHTests_Holes2(4, 4);
	T.True(Solver.Solve(Goal, 0, Keys) == ELPH_SolveStatus::Ok, "Solve at the goal is Ok");
	T.EqualInt(Keys.Num(), 0, "Solve at the goal: no keys");
	Keys.Add(ELPH_Key::R);
	T.True(Solver.Solve(Goal, 1, Keys) == ELPH_SolveStatus::Ok, "Solve at the goal, cursor on plate 1, is Ok");
	T.EqualInt(Keys.Num(), 0, "Solve at the goal clears the keys it was given");

	// Solve: two A/D presses in any case; D on plate 0 first (no cursor travel) and then plate 1 back, or from plate 1
	// first when the cursor is there. 3,4: D(0) -> 4,5; A(1) -> 4,4.
	TArray<int> Near = LPHTests_Holes2(3, 4);
	T.True(Solver.Solve(Near, 0, Keys) == ELPH_SolveStatus::Ok, "Solve 3,4 from plate 0");
	T.EqualStr(LPH::KeysText(Keys), "DWA", "3,4 from plate 0: the path with the least cursor travel");
	T.True(Solver.Solve(Near, 1, Keys) == ELPH_SolveStatus::Ok, "Solve 3,4 from plate 1");
	T.EqualStr(LPH::KeysText(Keys), "ASD", "3,4 from plate 1: the first move is on the cursor's plate");

	// Whatever Solve says, pressing it leaves every hole at 4 without a strain.
	TArray<int> Far = LPHTests_Holes2(7, 1);
	Cursor = 1;
	T.True(Solver.Solve(Far, Cursor, Keys) == ELPH_SolveStatus::Ok, "Solve 7,1");
	TArray<int> Played = Far;
	T.True(LPHTests_Replay(Solver, Played, Cursor, LPH::KeysText(Keys)), "the keys of Solve 7,1 do not strain");
	T.EqualInt(Played[0], 4, "7,1 solved: plate 0 at 4");
	T.EqualInt(Played[1], 4, "7,1 solved: plate 1 at 4");

	// BadState: not the lock's size, a hole outside 1..7, the cursor outside the plates.
	Keys.Add(ELPH_Key::R);
	T.True(Solver.Solve(Wrong, 0, Keys) == ELPH_SolveStatus::BadState, "Solve with three holes is BadState");
	T.EqualInt(Keys.Num(), 0, "BadState clears the keys");
	TArray<int> Short;
	Short.Add(4);
	T.True(Solver.Solve(Short, 0, Keys) == ELPH_SolveStatus::BadState, "Solve with one hole is BadState");
	T.True(Solver.Solve(Zero, 0, Keys) == ELPH_SolveStatus::BadState, "Solve with hole 0 is BadState");
	TArray<int> Eight = LPHTests_Holes2(4, 8);
	T.True(Solver.Solve(Eight, 0, Keys) == ELPH_SolveStatus::BadState, "Solve with hole 8 is BadState");
	T.True(Solver.Solve(Goal, -1, Keys) == ELPH_SolveStatus::BadState, "Solve with cursor -1 is BadState");
	T.True(Solver.Solve(Goal, 2, Keys) == ELPH_SolveStatus::BadState, "Solve with cursor 2 (two plates) is BadState");

	// NoSafePath: connections that push the plates out of 1..7 from the goal itself (four of them each way): no move
	// is possible anywhere near the goal.
	FLPH_LockGraph Stuck;
	Stuck.Plates = 2;
	for (int i = 0; i < 4; i++)
	{
		Stuck.Src.Add(0);
		Stuck.Dst.Add(1);
		Stuck.Dir.Add(1);
		Stuck.Src.Add(1);
		Stuck.Dst.Add(0);
		Stuck.Dir.Add(1);
	}
	ULPH_Solver StuckSolver = LPHTests_ReadySolver(T, Stuck);
	T.True(StuckSolver.IsReady(), "the stuck lock is ready");
	T.True(StuckSolver.Solve(Near, 0, Keys) == ELPH_SolveStatus::NoSafePath, "3,4 of the stuck lock has no safe path");
	T.EqualInt(Keys.Num(), 0, "NoSafePath: no keys");
	T.True(StuckSolver.Solve(Goal, 0, Keys) == ELPH_SolveStatus::Ok, "the goal of the stuck lock is solved already");
	T.True(!StuckSolver.Apply(Goal, 0, ELPH_Key::D, After, Cursor), "every move of the stuck lock strains at the goal");
	T.True(!StuckSolver.Apply(Goal, 1, ELPH_Key::A, After, Cursor), "every move of the stuck lock strains at the goal (A)");

	// Graphs the solver cannot take: it is ready with no plates and refuses every state (nobody waits for it).
	ULPH_Solver None = Cast<ULPH_Solver>(NewObject(T, ULPH_Solver::StaticClass()));
	None.Begin(LPHTests_FreePlates(0));
	T.True(None.IsReady(), "a graph without plates leaves the solver ready");
	T.EqualInt(None.Plates(), 0, "a graph without plates: Plates is 0");
	TArray<int> NoHoles;
	T.True(None.Solve(NoHoles, 0, Keys) == ELPH_SolveStatus::BadState, "a graph without plates: every state is BadState");
	None.Begin(LPHTests_FreePlates(8));
	T.True(None.IsReady(), "a graph with eight plates leaves the solver ready");
	T.EqualInt(None.Plates(), 0, "a graph with eight plates: Plates is 0");

	// Connections that name a plate the lock does not have are skipped; the rest works as it did.
	FLPH_LockGraph Odd = LPHTests_TwoPlates();
	Odd.Src.Add(5);
	Odd.Dst.Add(0);
	Odd.Dir.Add(-1);
	Odd.Src.Add(0);
	Odd.Dst.Add(-1);
	Odd.Dir.Add(1);
	Odd.Src.Add(1);
	Odd.Dst.Add(2);
	Odd.Dir.Add(1);
	ULPH_Solver OddSolver = LPHTests_ReadySolver(T, Odd);
	T.EqualInt(OddSolver.Plates(), 2, "a graph with connections to missing plates: Plates");
	T.True(OddSolver.Solve(Near, 0, Keys) == ELPH_SolveStatus::Ok, "a graph with connections to missing plates: Solve");
	T.EqualStr(LPH::KeysText(Keys), "DWA", "connections to missing plates are skipped");

	// Begin again on the same solver: the old lock is gone.
	Solver.Begin(LPHTests_FreePlates(5));
	T.True(!Solver.IsReady(), "Begin starts the search again");
	T.EqualInt(Solver.Plates(), 5, "Begin: the new plates");
	TArray<int> Goal5;
	for (int i = 0; i < 5; i++)
		Goal5.Add(4);
	T.True(Solver.Solve(Goal5, 0, Keys) == ELPH_SolveStatus::BadState, "a lock being searched cannot solve yet");
	int Calls = 0;
	while (!Solver.Step(1000000) && Calls < 1000)
		Calls++;
	T.True(Solver.IsReady(), "the second lock gets ready");
	T.True(Solver.Solve(Goal5, 0, Keys) == ELPH_SolveStatus::Ok, "the second lock solves");
	T.True(Solver.Solve(Goal, 0, Keys) == ELPH_SolveStatus::BadState, "the old lock's holes do not fit the new lock");

	// Step with no time at all: it still goes on (1000 states a call) and ends after a finite number of calls.
	ULPH_Solver Slow = Cast<ULPH_Solver>(NewObject(T, ULPH_Solver::StaticClass()));
	Slow.Begin(LPHTests_FreePlates(5));
	T.True(!Slow.IsReady(), "5 plates: not ready before the first Step");
	bool bDone = Slow.Step(0);
	T.True(!bDone, "5 plates (16,807 states): one 1000-state chunk is not all");
	T.True(!Slow.IsReady(), "5 plates: not ready after one chunk");
	int SlowCalls = 1;
	while (!bDone && SlowCalls < 1000)
	{
		bDone = Slow.Step(0);
		SlowCalls++;
	}
	T.True(bDone, "Step(0) gets the solver ready");
	T.True(Slow.IsReady(), "IsReady after the last Step");
	T.True(SlowCalls <= 17, "every Step(0) does at least a chunk of 1000 states, so 16,807 states take 17 calls at most");
	T.True(Slow.Step(0), "Step on a ready solver says so");

	// The same answer as the one-call search, and the least presses (the distance of every plate to 4).
	ULPH_Solver Quick = LPHTests_ReadySolver(T, LPHTests_FreePlates(5));
	TArray<int> Mixed;
	Mixed.Add(1);
	Mixed.Add(7);
	Mixed.Add(3);
	Mixed.Add(5);
	Mixed.Add(2);
	TArray<ELPH_Key> SlowKeys;
	T.True(Slow.Solve(Mixed, 0, SlowKeys) == ELPH_SolveStatus::Ok, "Slow solver: Solve");
	T.True(Quick.Solve(Mixed, 0, Keys) == ELPH_SolveStatus::Ok, "Quick solver: Solve");
	T.EqualStr(LPH::KeysText(SlowKeys), LPH::KeysText(Keys), "a search in slices finds the same keys");
	int Presses = 0;
	for (ELPH_Key Key : Keys)
	{
		if (LPH::IsMove(Key))
			Presses++;
	}
	T.EqualInt(Presses, 3 + 3 + 1 + 1 + 2, "free plates: one press for each step to 4");
}

// Checks one case of the 1.2.0 reference (GoldenSolver.as): the solver of this lock and Removed connections dropped,
// from the holes given (the first ones, as many as the lock has plates; the others are 0) and the cursor, must give
// the keys 1.2.0 gave ("-": no safe path), and pressing those keys must really end with every hole at 4.
namespace LPHGolden
{
	void Check(ULPH_TestRun T, ULPH_LockDb Db, FName Lock, int Removed, int H1, int H2, int H3, int H4, int H5, int H6, int H7, int Cursor, FString Keys)
	{
		FString LockName = Lock.ToString();
		FString Label = f"{LockName} ({Removed} removed)";
		FLPH_LockGraph Graph;
		int Dropped = 0;
		if (!Db.Find(Lock, Removed, Graph, Dropped))
		{
			T.True(false, Label + ": the lock is in the database");
			return;
		}

		TArray<int> All;
		All.Add(H1);
		All.Add(H2);
		All.Add(H3);
		All.Add(H4);
		All.Add(H5);
		All.Add(H6);
		All.Add(H7);
		TArray<int> Holes;
		for (int i = 0; i < Graph.Plates && i < All.Num(); i++)
			Holes.Add(All[i]);

		ULPH_Solver Solver = Cast<ULPH_Solver>(NewObject(T, ULPH_Solver::StaticClass()));
		int64 Started = LPH::NowMs();
		Solver.Begin(Graph);
		int Calls = 0;
		while (!Solver.Step(1000000) && Calls < 1000)
			Calls++;
		int Took = int(LPH::NowMs() - Started);
		T.True(Solver.IsReady(), Label + ": the solver gets ready");
		if (Graph.Plates == 7 && T.Output != nullptr)
			T.Output.Line(f"solver: {LockName} 7 plates ready in {Took} ms");

		TArray<ELPH_Key> Result;
		ELPH_SolveStatus Status = Solver.Solve(Holes, Cursor, Result);
		if (Keys == "-")
		{
			T.True(Status == ELPH_SolveStatus::NoSafePath, Label + ": no safe path, as in 1.2.0");
		}
		else
		{
			T.True(Status == ELPH_SolveStatus::Ok, Label + ": a safe path, as in 1.2.0");
			T.EqualStr(LPH::KeysText(Result), Keys, Label + ": the keys of 1.2.0");

			// The 1.2.0 keys pressed through Apply: no strain, and the lock ends open.
			int At = Cursor;
			bool bSafe = LPHTests_Replay(Solver, Holes, At, Keys);
			T.True(bSafe, Label + ": the keys of 1.2.0 do not strain");
			bool bOpen = true;
			for (int Hole : Holes)
			{
				if (Hole != 4)
					bOpen = false;
			}
			T.True(bOpen, Label + ": the keys of 1.2.0 leave every hole at 4");
		}

		// The next case builds its own solver, and the game frees these only after the whole run.
		Solver.Begin(LPHTests_FreePlates(0));
	}
}
